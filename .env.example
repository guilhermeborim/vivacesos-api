DATABASE_URL="postgresql://user:password@host:5434/dbname?schema=public"
DATABASE_HOST=''
DATABASE_PORT=''
DATABASE_USER=''
DATABASE_PASSWORD=''
DATABASE_NAME=''
# 'true' liga SSL na conexão (exigido por provedores gerenciados em produção, ex. Neon).
DATABASE_SSL='false'
PORT=3334
# JWT_SECRET: mínimo 32 caracteres. Expiries em segundos.
JWT_SECRET=''
JWT_EXPIRY=900
JWT_REFRESH_EXPIRY=604800
JWT_ISSUER=''
JWT_AUDIENCE=''
COOKIE_SECRET=''
# Chave de 32 bytes em UTF-8 ou 64 caracteres hexadecimais (32 bytes).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRYPTO_SECRET_KEY=''
NODE_ENV="DEV"
RESEND_API_KEY=''
CORS_ORIGIN='http://localhost:5173'
# URL do front-end (usada nos links dos e-mails) e remetente (domínio verificado no Resend).
APP_URL='http://localhost:5173'
MAIL_FROM='Vivace SOS <convites@vivacesos.com.br>'
# Google Agenda (opcional). Crie as credenciais em console.cloud.google.com (veja o CLAUDE.md).
# GOOGLE_REDIRECT_URI deve apontar para a API: http://localhost:3334/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
